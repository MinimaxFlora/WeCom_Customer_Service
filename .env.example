# ============================================================
# WeCom Customer Service - environment template
# Copy this file to .env and replace every change-me value.
# Never commit the real .env file.
# ============================================================

# ---------- Server ----------
DOCKER_SERVER_PORT=8081
SERVER_FORWARD_HEADERS_STRATEGY=framework

# ---------- H2 database ----------
DB_USER=kn_ai_chat
DB_PASSWORD=change-me-db-password

# ---------- Redis ----------
REDIS_HOST=wecom-redis
REDIS_PORT=16379
REDIS_PASSWORD=change-me-redis-password
REDIS_DATABASE=0

# ---------- WeCom / WeChat Customer Service ----------
# Callback URL: https://your-domain.example/wechat/callback
WECHAT_TOKEN=change-me-token
WECHAT_AES_KEY=change-me-43-character-aes-key
WECHAT_CORP_ID=change-me-corp-id
WECHAT_SECRET=change-me-customer-service-secret
WECHAT_OPEN_KFID=change-me-open-kfid

# ---------- Admin console ----------
ADMIN_PASSWORD=change-me-admin-password
# At least 32 random characters. Do not change after API keys are saved.
APP_ENCRYPTION_KEY=change-me-32-character-random-encryption-key

# ---------- Default AI / DeepSeek ----------
DEFAULT_AI_BASE_URL=https://api.deepseek.com/chat/completions
AI_API_KEY=sk-change-me
DEFAULT_AI_MODEL=deepseek-chat
DEFAULT_AI_SYSTEM_PROMPT="你是一个乐于助人的AI助手"

# ---------- SiliconFlow (image / voice / embedding, optional) ----------
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_IMAGE_MODEL=Kwai-Kolors/Kolors
SILICONFLOW_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
SILICONFLOW_STT_MODEL=FunAudioLLM/SenseVoiceSmall
SILICONFLOW_VOICE=FunAudioLLM/CosyVoice2-0.5B:alex
SILICONFLOW_VLM_MODEL=Qwen/Qwen2-VL-72B-Instruct

# ---------- Enterprise RAG / embeddings ----------
# Text RAG works without an embedding key using lexical fallback.
RAG_ENABLED=true
RAG_MODEL=Qwen/Qwen3-Embedding-8B
RAG_BASE_URL=https://api.siliconflow.cn/v1
RAG_API_KEY=

# ---------- Optional MCP ----------
MCP_BASE_URL=
MCP_MODEL=
MCP_API_KEY=

# ---------- Optional tools ----------
GOOGLE_API_KEY=
GOOGLE_CX_ID=
BRAVE_API_KEY=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=
NOTION_API_KEY=
NOTION_API_VERSION=
NOTION_BASE_URL=
NOTION_DATABASE_ID=
